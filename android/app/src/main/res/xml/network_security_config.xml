<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- دامنه‌های بانکی که ممکن است نیاز به http داشته باشند (احتیاطی) -->
        <domain includeSubdomains="true">shaparak.ir</domain>
        <domain includeSubdomains="true">zarinpal.com</domain>
    </domain-config>
</network-security-config>
